#!/bin/bash
set -euo pipefail
repo=$(cd "$(dirname "$0")/../../.." && pwd)
if ! xcrun --find swiftc >/dev/null 2>&1; then
  /usr/bin/osascript -e 'display dialog "Apple Command Line Tools are needed once to build Support from this Git checkout. Accept Apple’s installation prompt, then reopen Build Support. No Apple membership is required." buttons {"OK"} default button "OK"'
  /usr/bin/xcode-select --install || true
  exit 0
fi
mkdir -p "$repo/.mac-build"
if ! xcrun swiftc -swift-version 5 -framework AppKit "$repo/scripts/macos/BuildUI.swift" -o "$repo/.mac-build/SupportBuilder" > "$repo/.mac-build/bootstrap.log" 2>&1; then
  /usr/bin/osascript -e 'display dialog "The build helper could not compile. Check .mac-build/bootstrap.log in the repository and update Apple Command Line Tools." buttons {"OK"} default button "OK"'
  exit 1
fi
exec "$repo/.mac-build/SupportBuilder" "$repo"
