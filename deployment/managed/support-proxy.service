[Unit]
Description=Support allowlisted vsock egress proxy
After=local-fs.target

[Service]
User=support-bridge
ExecStart=/usr/bin/python3 /opt/support-bridge/guest-bridge.py proxy
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_VSOCK AF_INET AF_UNIX
MemoryMax=96M
TasksMax=16

[Install]
WantedBy=multi-user.target
