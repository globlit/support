#!/usr/bin/env bash
# Installs and manages the Support server as a systemd user service on a Linux VM.
# Run as the VM user, not as root. Run `supportctl help` for the commands.
set -euo pipefail

SCRIPT=$(readlink -f "${BASH_SOURCE[0]}")
REPO=$(cd "$(dirname "$SCRIPT")/../.." && pwd)
SERVICE=support.service
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT="$UNIT_DIR/$SERVICE"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/support"
ENV_FILE="$CONFIG_DIR/support.env"
NODE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/support"
LOCAL_BIN="$HOME/.local/bin"
HELPER="$LOCAL_BIN/supportctl"
TOOLS_DIR="$NODE_ROOT/bin"
NODE_MIN=24.5.0
NODE_PIN=$(sed -n 's/.*"nodeVersion": *"\([0-9.]*\)".*/\1/p' "$REPO/scripts/macos/assets.json")
WORK=

# Tool versions. Update each version with its SHA-256 values.
TOOLBOX_VERSION=v0.4.10
TOOLBOX_RELEASE="https://github.com/globlit/toolbox/releases/download/$TOOLBOX_VERSION"
TOOLBOX_IDENTITY="https://github.com/globlit/toolbox/.github/workflows/ci.yml@refs/heads/master"
TOOLBOX_ISSUER="https://token.actions.githubusercontent.com"
COSIGN_VERSION=v3.1.4
declare -A COSIGN_SHA256=(
  [amd64]=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
  [arm64]=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
)
KUBECTL_VERSION=v1.34.13
declare -A KUBECTL_SHA256=(
  [amd64]=b4bb494e9466a7a94bb851414548bc0d3e2f8da90757e6eccc3371e648648591
  [arm64]=66e8283d52d9bc1f9c0e9daade7c971cd20db5a379306862897dfb25395f3e03
)

# Prints the value of KEY from the environment, then from ENV_FILE, then DEFAULT.
setting() {
  local key=$1 default=$2 value=${!1:-}
  if [ -z "$value" ] && [ -r "$ENV_FILE" ]; then
    value=$(sed -n "s/^[[:space:]]*$key=[\"']\{0,1\}\([^\"']*\)[\"']\{0,1\}[[:space:]]*\$/\1/p" "$ENV_FILE" | tail -n1)
  fi
  echo "${value:-$default}"
}
PORT=$(setting SUPPORT_PORT 4173)
TOOLBOX=$(setting SUPPORT_TOOLBOX_BINARY /usr/local/bin/toolbox)

cleanup() { if [ -n "$WORK" ]; then rm -rf "$WORK"; fi; }
trap cleanup EXIT
workdir() { [ -n "$WORK" ] || WORK=$(mktemp -d); }

info() { printf '%s\n' "$*"; }
warn() { printf 'Warning: %s\n' "$*" >&2; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

as_root() {
  if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

version_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]; }

node_arch() {
  case "$(uname -m)" in
    x86_64) echo x64 ;;
    aarch64 | arm64) echo arm64 ;;
    *) die "Unsupported CPU architecture: $(uname -m)." ;;
  esac
}

go_arch() {
  case "$(uname -m)" in
    x86_64) echo amd64 ;;
    aarch64 | arm64) echo arm64 ;;
    *) die "Unsupported CPU architecture: $(uname -m)." ;;
  esac
}

download() { curl -fsSL --proto '=https' --retry 3 "$1" -o "$2"; }

# Stops the script unless FILE has the SHA-256 value EXPECTED.
verify_sha256() {
  local file=$1 expected=$2 label=$3 actual
  actual=$(sha256sum "$file" | cut -d' ' -f1)
  [ "$actual" = "$expected" ] || die "Checksum mismatch for $label: expected $expected, got $actual."
}

managed_node_dir() { echo "$NODE_ROOT/node-v$NODE_PIN-linux-$(node_arch)"; }

# Prints the path of a Node binary at NODE_MIN or later.
find_node() {
  local candidate version
  for candidate in "$(managed_node_dir)/bin/node" "$(command -v node 2>/dev/null || true)"; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    version=$("$candidate" --version 2>/dev/null | sed 's/^v//') || continue
    if version_ge "$version" "$NODE_MIN"; then readlink -f "$candidate"; return 0; fi
  done
  return 1
}

require_node() {
  NODE_BIN=$(find_node) || die "Node $NODE_MIN or later not found. Run: supportctl install"
  export PATH="$(dirname "$NODE_BIN"):$PATH"
}

require_user_systemd() {
  [ "$(id -u)" -ne 0 ] || die "Run supportctl as the VM user, not as root."
  command -v systemctl >/dev/null || die "systemctl not found. This script requires systemd."
  systemctl --user show-environment >/dev/null 2>&1 || die "The systemd user manager is unreachable. Log in as this user directly (not with sudo or su), then retry."
}

install_packages() {
  local missing=() cmd pkg
  for pair in curl:curl git:git tar:tar gzip:gzip sha256sum:coreutils; do
    cmd=${pair%%:*}; pkg=${pair#*:}
    command -v "$cmd" >/dev/null || missing+=("$pkg")
  done
  [ -e /etc/ssl/certs/ca-certificates.crt ] || missing+=(ca-certificates)
  [ ${#missing[@]} -eq 0 ] && { info "System packages: present."; return; }
  command -v apt-get >/dev/null || die "Install these packages, then retry: ${missing[*]}"
  info "Installing system packages: ${missing[*]}"
  as_root apt-get update -qq
  as_root apt-get install -y -qq "${missing[@]}"
}

install_node() {
  local found dir arch name url tmp
  if found=$(find_node); then info "Node: $found ($("$found" --version))."; return; fi
  [ -n "$NODE_PIN" ] || die "nodeVersion not found in $REPO/scripts/macos/assets.json."
  arch=$(node_arch); dir=$(managed_node_dir); name="node-v$NODE_PIN-linux-$arch.tar.gz"
  url="https://nodejs.org/dist/v$NODE_PIN"
  info "Installing Node $NODE_PIN in $dir"
  workdir; tmp="$WORK"
  curl -fsSL --proto '=https' "$url/$name" -o "$tmp/$name"
  curl -fsSL --proto '=https' "$url/SHASUMS256.txt" -o "$tmp/SHASUMS256.txt"
  (cd "$tmp" && grep " $name\$" SHASUMS256.txt | sha256sum -c --quiet -) || die "Checksum mismatch for $name."
  mkdir -p "$NODE_ROOT"
  tar -xzf "$tmp/$name" -C "$NODE_ROOT"
  [ -x "$dir/bin/node" ] || die "Node archive did not contain $dir/bin/node."
  info "Node: $dir/bin/node ($("$dir/bin/node" --version))."
}

find_claude() {
  command -v claude 2>/dev/null && return 0
  [ -x "$HOME/.local/bin/claude" ] && { echo "$HOME/.local/bin/claude"; return 0; }
  return 1
}

install_claude() {
  local found tmp
  if found=$(find_claude); then info "Claude Code: $found."; return; fi
  info "Installing Claude Code with the official installer (https://claude.ai/install.sh)."
  workdir; tmp="$WORK/claude-install.sh"
  curl -fsSL --proto '=https' https://claude.ai/install.sh -o "$tmp"
  bash "$tmp"
  found=$(find_claude) || die "Claude Code installation finished, but claude was not found in PATH or ~/.local/bin."
  info "Claude Code: $found. Sign in with: claude auth login"
}

find_kubectl() {
  command -v kubectl 2>/dev/null && return 0
  [ -x "$LOCAL_BIN/kubectl" ] && { echo "$LOCAL_BIN/kubectl"; return 0; }
  return 1
}

install_kubectl() {
  local found arch tmp
  if found=$(find_kubectl); then info "kubectl: $found ($("$found" version --client 2>/dev/null | head -n1))."; return; fi
  arch=$(go_arch); workdir; tmp="$WORK/kubectl"
  info "Installing kubectl $KUBECTL_VERSION in $LOCAL_BIN/kubectl"
  download "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/$arch/kubectl" "$tmp"
  verify_sha256 "$tmp" "${KUBECTL_SHA256[$arch]}" "kubectl $KUBECTL_VERSION linux/$arch"
  mkdir -p "$LOCAL_BIN"
  install -m 0755 "$tmp" "$LOCAL_BIN/kubectl"
  info "kubectl: $LOCAL_BIN/kubectl."
}

# Prints the path of the Cosign binary. Downloads it if missing or invalid.
cosign_bin() {
  local arch bin="$TOOLS_DIR/cosign"
  arch=$(go_arch)
  if [ -x "$bin" ] && [ "$(sha256sum "$bin" | cut -d' ' -f1)" = "${COSIGN_SHA256[$arch]}" ]; then echo "$bin"; return; fi
  workdir
  info "Installing Cosign $COSIGN_VERSION in $bin" >&2
  download "https://github.com/sigstore/cosign/releases/download/$COSIGN_VERSION/cosign-linux-$arch" "$WORK/cosign"
  verify_sha256 "$WORK/cosign" "${COSIGN_SHA256[$arch]}" "cosign $COSIGN_VERSION linux/$arch"
  mkdir -p "$TOOLS_DIR"
  install -m 0755 "$WORK/cosign" "$bin"
  echo "$bin"
}

toolbox_version() { "$1" version 2>/dev/null | head -n1; }

# Installs Toolbox TOOLBOX_VERSION after signature and checksum verification.
install_toolbox() {
  local target="$LOCAL_BIN/toolbox" current arch dir cosign name count configured
  if [ -x "$TOOLBOX" ]; then
    current=$(toolbox_version "$TOOLBOX")
    if printf '%s' "$current" | grep -qF "$TOOLBOX_VERSION"; then info "Toolbox: $TOOLBOX ($current)."; return; fi
    if [ "$TOOLBOX" != "$target" ]; then warn "Toolbox at $TOOLBOX reports '$current', not $TOOLBOX_VERSION. It was not installed by supportctl and stays unchanged."; return; fi
    info "Upgrading Toolbox at $target from '$current' to $TOOLBOX_VERSION."
  fi
  arch=$(go_arch); name="toolbox-linux-$arch"; workdir; dir="$WORK/toolbox"; mkdir -p "$dir"
  info "Installing Toolbox $TOOLBOX_VERSION in $target"
  for file in "$name" VERSION SHA256SUMS SHA256SUMS.sigstore.json; do download "$TOOLBOX_RELEASE/$file" "$dir/$file"; done
  cosign=$(cosign_bin)
  "$cosign" verify-blob --bundle "$dir/SHA256SUMS.sigstore.json" \
    --certificate-identity "$TOOLBOX_IDENTITY" --certificate-oidc-issuer "$TOOLBOX_ISSUER" "$dir/SHA256SUMS" >/dev/null \
    || die "Cosign could not verify the signature of SHA256SUMS for Toolbox $TOOLBOX_VERSION."
  count=$(grep -cE "^[0-9a-f]{64} [ *]$name\$" "$dir/SHA256SUMS" || true)
  [ "$count" = 1 ] || die "SHA256SUMS lists $name $count times. Expected exactly once."
  (cd "$dir" && grep -E "^[0-9a-f]{64} [ *]$name\$" SHA256SUMS | sha256sum --strict --quiet -c -) || die "Checksum mismatch for $name."
  [ "$(tr -d '[:space:]' < "$dir/VERSION")" = "$TOOLBOX_VERSION" ] || die "Toolbox VERSION file does not contain $TOOLBOX_VERSION."
  mkdir -p "$LOCAL_BIN"
  install -m 0755 "$dir/$name" "$target"
  configured=$(grep -E '^[[:space:]]*SUPPORT_TOOLBOX_BINARY=' "$ENV_FILE" 2>/dev/null | tail -n1 || true)
  if [ -z "$configured" ]; then
    mkdir -p "$CONFIG_DIR"
    printf 'SUPPORT_TOOLBOX_BINARY=%s\n' "$target" >> "$ENV_FILE"
    info "Set SUPPORT_TOOLBOX_BINARY=$target in $ENV_FILE."
  elif [ "$(setting SUPPORT_TOOLBOX_BINARY '')" != "$target" ]; then
    warn "$ENV_FILE sets $configured. Change it to SUPPORT_TOOLBOX_BINARY=$target to use the installed Toolbox."
  fi
  TOOLBOX=$target
  info "Toolbox: $target ($(toolbox_version "$target"))."
}

enable_linger() {
  [ "$(loginctl show-user "$USER" --property=Linger --value 2>/dev/null || echo no)" = yes ] && return
  info "Enabling linger for $USER so the service starts at boot without a login."
  as_root loginctl enable-linger "$USER"
}

build_app() {
  require_node
  info "Building Support in $REPO with Node $(node --version)."
  (cd "$REPO" && npm ci --no-audit --no-fund && npx vite build && node scripts/package-companion.mjs)
}

# Prints the systemd unit for the current checkout and Node binary.
render_unit() {
  require_node
  cat <<EOF
# Generated by $SCRIPT. Rerun "supportctl install" after moving the checkout or changing Node.
[Unit]
Description=Support server ($REPO)

[Service]
Type=simple
WorkingDirectory=$REPO
Environment="PATH=$(dirname "$NODE_BIN"):%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-$ENV_FILE
ExecStart="$NODE_BIN" "$REPO/node_modules/tsx/dist/cli.mjs" server/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
}

write_unit() {
  mkdir -p "$UNIT_DIR" "$CONFIG_DIR"
  [ -e "$ENV_FILE" ] || printf '%s\n' '# Environment for support.service. See "Configuration" in README.md. Example:' '# SUPPORT_TOOLBOX_BINARY=/usr/local/bin/toolbox' > "$ENV_FILE"
  render_unit > "$UNIT"
  systemctl --user daemon-reload
  info "Unit: $UNIT"
}

link_helper() {
  mkdir -p "$(dirname "$HELPER")"
  ln -sfn "$SCRIPT" "$HELPER"
  info "Helper: $HELPER"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) warn "$HOME/.local/bin is not in PATH. Run $HELPER by its full path or add the folder to PATH." ;; esac
}

responds() { curl -fsS -m 5 "http://127.0.0.1:$PORT/api/session" >/dev/null 2>&1; }

# Waits up to 60 seconds for the server to answer on PORT.
wait_ready() {
  local i
  for i in $(seq 1 30); do responds && return 0; sleep 2; done
  warn "The server did not respond on port $PORT within 60 seconds. Run: supportctl logs -n 100"
  return 1
}

port_in_use() {
  command -v ss >/dev/null && ss -ltnH "sport = :$PORT" 2>/dev/null | grep -q .
}

cmd_install() {
  require_user_systemd
  install_packages
  install_node
  install_claude
  install_kubectl
  install_toolbox
  build_app
  if ! systemctl --user is-active --quiet "$SERVICE" && port_in_use; then
    die "Port $PORT is already in use. Stop the other server (for example npm start or a container), then retry."
  fi
  write_unit
  enable_linger
  systemctl --user enable "$SERVICE"
  if systemctl --user is-active --quiet "$SERVICE"; then systemctl --user restart "$SERVICE"; else systemctl --user start "$SERVICE"; fi
  link_helper
  wait_ready || true
  local status=0
  cmd_check || status=$?
  if [ ! -e "$HOME/.config/toolbox/config.json" ]; then
    info "Next step for Toolbox: paste its configuration in Settings > Connections > Toolbox, or run: $TOOLBOX config generate --detect-contexts"
  fi
  return $status
}

cmd_rebuild() {
  require_user_systemd
  build_app
  write_unit
  systemctl --user restart "$SERVICE"
  info "Restarted $SERVICE."
  wait_ready
}

cmd_update() {
  require_user_systemd
  git -C "$REPO" pull --ff-only
  cmd_rebuild
}

cmd_check() {
  local ok=0 node claude kubectl
  if node=$(find_node); then info "ok    Node $("$node" --version) at $node"; else info "fail  Node $NODE_MIN or later not found"; ok=1; fi
  if claude=$(find_claude); then info "ok    Claude Code at $claude"; else info "warn  Claude Code not found"; fi
  if kubectl=$(find_kubectl); then info "ok    kubectl at $kubectl"; else info "warn  kubectl not found"; fi
  if [ -x "$TOOLBOX" ]; then info "ok    Toolbox $(toolbox_version "$TOOLBOX") at $TOOLBOX"; else info "warn  Toolbox not found at $TOOLBOX"; fi
  if [ -e "$UNIT" ]; then info "ok    Unit $UNIT"; else info "fail  Unit not installed"; ok=1; fi
  if systemctl --user is-active --quiet "$SERVICE"; then info "ok    $SERVICE is active"; else info "fail  $SERVICE is not active"; ok=1; fi
  if responds; then info "ok    http://127.0.0.1:$PORT responds"; else info "fail  http://127.0.0.1:$PORT does not respond"; ok=1; fi
  [ "$(loginctl show-user "$USER" --property=Linger --value 2>/dev/null || echo no)" = yes ] && info "ok    Linger enabled" || info "warn  Linger disabled: the service starts only after you log in"
  return $ok
}

cmd_uninstall() {
  require_user_systemd
  systemctl --user disable --now "$SERVICE" 2>/dev/null || true
  rm -f "$UNIT"
  systemctl --user daemon-reload
  [ -L "$HELPER" ] && rm -f "$HELPER"
  info "Removed $SERVICE and $HELPER."
  info "Kept: the checkout, its data folder ($REPO/.support-data or SUPPORT_DATA_DIR), $ENV_FILE and $NODE_ROOT."
}

usage() {
  cat <<EOF
Usage: supportctl <command>

Commands:
  install     Install system packages, Node, Claude Code, kubectl, Toolbox and the app, then enable and start $SERVICE.
  start       Start $SERVICE.
  stop        Stop $SERVICE.
  restart     Restart $SERVICE.
  status      Show the status of $SERVICE.
  logs [ARGS] Show the service log. Without ARGS, follow new lines. ARGS go to journalctl, for example: logs -n 200
  rebuild     Reinstall dependencies, rebuild the app, rewrite the unit and restart $SERVICE.
  update      Run git pull --ff-only in the checkout, then rebuild.
  check       Check Node, Claude Code, kubectl, Toolbox, the unit, the service, the HTTP port and linger.
  unit        Print the systemd unit that install writes.
  uninstall   Stop and remove $SERVICE and the helper link. Keeps data, Node and the checkout.
  help        Show this help.

Checkout: $REPO
Environment overrides: $ENV_FILE
EOF
}

main() {
  local command=${1:-help}; shift || true
  case "$command" in
    install) cmd_install ;;
    start | stop | restart) require_user_systemd; systemctl --user "$command" "$SERVICE" ;;
    status) require_user_systemd; systemctl --user status "$SERVICE" --no-pager ;;
    logs) if [ $# -eq 0 ]; then journalctl --user -u "$SERVICE" -f; else journalctl --user -u "$SERVICE" "$@"; fi ;;
    rebuild) cmd_rebuild ;;
    update) cmd_update ;;
    check) cmd_check ;;
    unit) render_unit ;;
    uninstall) cmd_uninstall ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
